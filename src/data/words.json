[
  {
    "id": "hola", "es": "hola", "sk": ["ahoj"], "pos": "phrase", "level": "A1", "topics": ["greetings"],
    "examples": [{ "es": "¡Hola! ¿Cómo estás?", "sk": "Ahoj! Ako sa máš?" }],
    "note": "V Mexiku sa „hola“ bežne používa aj s cudzími ľuďmi, nie je to neslušné."
  },
  {
    "id": "buenos-dias", "es": "buenos días", "sk": ["dobré ráno", "dobrý deň"], "pos": "phrase", "level": "A1", "topics": ["greetings"],
    "examples": [{ "es": "Buenos días, señora. ¿Cómo está?", "sk": "Dobrý deň, pani. Ako sa máte?" }],
    "note": "Používa sa do obeda."
  },
  {
    "id": "buenas-tardes", "es": "buenas tardes", "sk": ["dobrý deň", "dobré popoludnie"], "pos": "phrase", "level": "A1", "topics": ["greetings"],
    "examples": [{ "es": "Buenas tardes, ¿tiene una mesa para dos?", "sk": "Dobrý deň, máte voľný stôl pre dvoch?" }],
    "note": "Používa sa od obeda, kým sa nezotmie."
  },
  {
    "id": "buenas-noches", "es": "buenas noches", "sk": ["dobrý večer", "dobrú noc"], "pos": "phrase", "level": "A1", "topics": ["greetings"],
    "examples": [{ "es": "Buenas noches, nos vemos mañana.", "sk": "Dobrú noc, uvidíme sa zajtra." }],
    "note": "Keď je už tma, používa sa pri príchode aj pri odchode."
  },
  {
    "id": "gracias", "es": "gracias", "sk": ["ďakujem", "vďaka"], "pos": "phrase", "level": "A1", "topics": ["greetings"],
    "examples": [{ "es": "Muchas gracias por todo.", "sk": "Veľmi pekne ďakujem za všetko." }]
  },
  {
    "id": "por-favor", "es": "por favor", "sk": ["prosím"], "pos": "phrase", "level": "A1", "topics": ["greetings"],
    "examples": [{ "es": "Un café, por favor.", "sk": "Jednu kávu, prosím." }]
  },
  {
    "id": "de-nada", "es": "de nada", "sk": ["nie je za čo"], "pos": "phrase", "level": "A1", "topics": ["greetings"],
    "examples": [{ "es": "—Gracias. —De nada.", "sk": "„Ďakujem.“ „Nie je za čo.“" }],
    "note": "V Mexiku počuješ aj „por nada“."
  },
  {
    "id": "perdon", "es": "perdón", "sk": ["prepáč", "prepáčte"], "pos": "phrase", "level": "A1", "topics": ["greetings"],
    "examples": [{ "es": "Perdón, ¿dónde está el baño?", "sk": "Prepáčte, kde je tu záchod?" }],
    "note": "Používa sa aj na upútanie pozornosti, podobne ako slovenské „prepáčte“."
  },
  {
    "id": "mande", "es": "¿mande?", "sk": ["prosím? (keď si nepočul)", "áno? (keď ťa niekto volá)"], "pos": "phrase", "level": "A1", "topics": ["greetings"],
    "examples": [
      { "es": "—¡Carlos! —¿Mande?", "sk": "„Carlos!“ „Áno?“" },
      { "es": "¿Mande? No le entendí.", "sk": "Prosím? Nerozumel som vám." }
    ],
    "note": "Typicky mexické. Zdvorilá reakcia, keď niekoho nepočuješ alebo keď ťa niekto osloví. Samotné „¿Qué?“ znie menej zdvorilo."
  },
  {
    "id": "hasta-luego", "es": "hasta luego", "sk": ["dovidenia", "zatiaľ"], "pos": "phrase", "level": "A1", "topics": ["greetings"],
    "examples": [{ "es": "Hasta luego, que te vaya bien.", "sk": "Zatiaľ, maj sa dobre." }]
  },

  {
    "id": "familia", "es": "familia", "sk": ["rodina"], "pos": "noun", "gender": "f", "level": "A1", "topics": ["family"],
    "examples": [{ "es": "Mi familia vive en Guadalajara.", "sk": "Moja rodina býva v Guadalajare." }]
  },
  {
    "id": "mama", "es": "mamá", "sk": ["mama", "mamička"], "pos": "noun", "gender": "f", "level": "A1", "topics": ["family"],
    "examples": [{ "es": "Mi mamá cocina muy rico.", "sk": "Moja mama varí veľmi chutne." }]
  },
  {
    "id": "papa-2", "es": "papá", "sk": ["otec", "ocko"], "pos": "noun", "gender": "m", "level": "A1", "topics": ["family"],
    "examples": [{ "es": "Mi papá trabaja en un banco.", "sk": "Môj otec pracuje v banke." }],
    "note": "Pozor na prízvuk: papá = otec, papa = zemiak. Mis papás = moji rodičia."
  },
  {
    "id": "hermano", "es": "hermano", "sk": ["brat"], "pos": "noun", "gender": "m", "level": "A1", "topics": ["family"],
    "examples": [{ "es": "Mi hermano vive en Monterrey.", "sk": "Môj brat býva v Monterrey." }],
    "note": "hermana = sestra, hermanos = bratia alebo súrodenci."
  },
  {
    "id": "hijo", "es": "hijo", "sk": ["syn"], "pos": "noun", "gender": "m", "level": "A1", "topics": ["family"],
    "examples": [{ "es": "¿Cuántos hijos tienes?", "sk": "Koľko máš detí?" }],
    "note": "hija = dcéra, hijos = synovia alebo (vlastné) deti."
  },
  {
    "id": "esposo", "es": "esposo", "sk": ["manžel"], "pos": "noun", "gender": "m", "level": "A1", "topics": ["family"],
    "examples": [{ "es": "Mi esposo se llama Luis.", "sk": "Môj manžel sa volá Luis." }],
    "note": "esposa = manželka."
  },
  {
    "id": "abuela", "es": "abuela", "sk": ["stará mama", "babka"], "pos": "noun", "gender": "f", "level": "A1", "topics": ["family"],
    "examples": [{ "es": "Los domingos comemos con mi abuela.", "sk": "Každú nedeľu obedujeme s babkou." }],
    "note": "abuelo = starý otec, abuelos = starí rodičia."
  },
  {
    "id": "amigo", "es": "amigo", "sk": ["kamarát", "priateľ"], "pos": "noun", "gender": "m", "level": "A1", "topics": ["family"],
    "examples": [{ "es": "Voy al cine con unos amigos.", "sk": "Idem do kina s kamarátmi." }],
    "note": "amiga = kamarátka."
  },

  {
    "id": "comida", "es": "comida", "sk": ["jedlo", "obed"], "pos": "noun", "gender": "f", "level": "A1", "topics": ["food"],
    "examples": [
      { "es": "La comida está lista.", "sk": "Obed je hotový." },
      { "es": "Me gusta mucho la comida mexicana.", "sk": "Veľmi mi chutí mexické jedlo." }
    ],
    "note": "V Mexiku je „la comida“ hlavné jedlo dňa, zvyčajne medzi 14:00 a 16:00."
  },
  {
    "id": "agua", "es": "agua", "sk": ["voda"], "pos": "noun", "gender": "f", "level": "A1", "topics": ["food"],
    "examples": [{ "es": "¿Me da un vaso de agua, por favor?", "sk": "Môžete mi dať pohár vody, prosím?" }],
    "note": "Je ženského rodu, ale v jednotnom čísle sa hovorí „el agua“ (kvôli prízvuku na prvom a). Agua de jamaica = osviežujúci nápoj z ibišteka."
  },
  {
    "id": "cafe", "es": "café", "sk": ["káva", "kaviareň"], "pos": "noun", "gender": "m", "level": "A1", "topics": ["food"],
    "examples": [{ "es": "Tomo un café cada mañana.", "sk": "Každé ráno si dám kávu." }]
  },
  {
    "id": "jugo", "es": "jugo", "sk": ["džús"], "pos": "noun", "gender": "m", "level": "A1", "topics": ["food"],
    "examples": [{ "es": "Un jugo de naranja, por favor.", "sk": "Pomarančový džús, prosím." }],
    "note": "V Španielsku „zumo“, v Mexiku vždy „jugo“."
  },
  {
    "id": "tortilla", "es": "tortilla", "sk": ["tortilla (kukuričná placka)"], "pos": "noun", "gender": "f", "level": "A1", "topics": ["food"],
    "examples": [{ "es": "Los tacos se hacen con tortillas de maíz.", "sk": "Tacos sa robia z kukuričných tortíl." }],
    "note": "V Mexiku je tortilla tenká placka z kukurice alebo pšenice, nie zemiaková omeleta ako v Španielsku."
  },
  {
    "id": "papa", "es": "papa", "sk": ["zemiak"], "pos": "noun", "gender": "f", "level": "A1", "topics": ["food"],
    "examples": [{ "es": "Quiero una hamburguesa con papas.", "sk": "Chcem hamburger s hranolkami." }],
    "note": "V Španielsku „patata“. Pozor: papá (s prízvukom) = otec. Papas fritas = hranolky alebo čipsy."
  },
  {
    "id": "pollo", "es": "pollo", "sk": ["kura", "kuracie mäso"], "pos": "noun", "gender": "m", "level": "A1", "topics": ["food"],
    "examples": [{ "es": "Hoy hay pollo con arroz.", "sk": "Dnes je kura s ryžou." }]
  },
  {
    "id": "rico", "es": "rico", "feminine": "rica", "sk": ["chutný", "bohatý"], "pos": "adj", "level": "A1", "topics": ["food"],
    "examples": [{ "es": "Los tacos están muy ricos.", "sk": "Tie tacos sú výborné." }],
    "note": "O jedle so slovesom estar: ¡Está muy rico! = Je to veľmi chutné. So slovesom ser znamená bohatý: Es rico."
  },
  {
    "id": "cuenta", "es": "cuenta", "sk": ["účet"], "pos": "noun", "gender": "f", "level": "A1", "topics": ["food"],
    "examples": [{ "es": "La cuenta, por favor.", "sk": "Účet, prosím." }]
  },

  {
