[
  {
    "id": "hola",
    "es": "hola",
    "sk": ["ahoj"],
    "pos": "phrase",
    "level": "A1",
    "topics": ["greetings"],
    "examples": [{ "es": "¡Hola! ¿Cómo estás?", "sk": "Ahoj! Ako sa máš?" }],
    "note": "V Mexiku sa „hola“ bežne používa aj s cudzími ľuďmi, nie je to neslušné."
  },
  {
    "id": "buenos-dias",
    "es": "buenos días",
    "sk": ["dobré ráno", "dobrý deň"],
    "pos": "phrase",
    "level": "A1",
    "topics": ["greetings"],
    "examples": [{ "es": "Buenos días, señora. ¿Cómo está?", "sk": "Dobrý deň, pani. Ako sa máte?" }],
    "note": "Používa sa do obeda."
  },
  {
    "id": "buenas-tardes",
    "es": "buenas tardes",
    "sk": ["dobrý deň", "dobré popoludnie"],
    "pos": "phrase",
    "level": "A1",
    "topics": ["greetings"],
    "examples": [{ "es": "Buenas tardes, ¿tiene una mesa para dos?", "sk": "Dobrý deň, máte voľný stôl pre dvoch?" }],
    "note": "Používa sa od obeda, kým sa nezotmie."
  },
  {
    "id": "buenas-noches",
