[
  {
    "id": "hola",
    "es": "hola",
    "sk": ["ahoj"],
    "pos": "phrase",
    "level": "A1",
    "topics": ["greetings"],
    "examples": [{ "es": "¡Hola! ¿Cómo estás?", "sk": "Ahoj! Ako sa máš?" }],
    "note": "V Mexiku sa „hola“ bežne používa aj s cudzími ľuďmi, nie je to neslušné."
  },
  {
